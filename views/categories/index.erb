<h2>Alla kategorier i butiken</h2>
<ul>
<% @categories.each do |category| %>
<li>
	<a href="/categories/<%= category["id"]%>">
		<%= category["name"] %>
	</a>
    <form class="delete" action="/categories/<%=category["id"]%>/delete" method="post">
       		<input type="submit" value="Ta bort">
   	</form>
    <a class="edit" href="/categories/<%=category["id"]%>/edit">Ändra</a>
    <a style="color:black;">
        <br>
        <%= category["description"]%>
	</a>
	</li>
    <br>
<% end %>
</ul>